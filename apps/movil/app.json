{
  "expo": {
    "name": "APP-MONITOR",
    "slug": "app-monitor",
    "version": "0.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.angelgarcia.appmonitor"
    },
    "android": {
      "package": "com.angelgarcia.appmonitor",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "REQUEST_INSTALL_PACKAGES",
        "INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/splash.png"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9b3139b8-1c9e-4b54-83c8-82a9da2b2b92"
      }
    },
    "owner": "rvcenter"
  }
}
